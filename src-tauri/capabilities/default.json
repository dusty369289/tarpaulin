{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Tarpaulin's only capability: the app's own commands. No generic HTTP, filesystem or shell access from JS.",
  "windows": ["main"],
  "permissions": [
    "allow-canvas-request",
    "allow-auth-status",
    "allow-save-token",
    "allow-oauth-login",
    "allow-logout",
    "allow-open-external",
    "allow-open-web-link",
    "allow-app-version",
    "allow-check-update",
    "allow-install-update",
    "allow-notification-permission",
    "allow-request-notification-permission",
    "allow-notify",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-launched-at-login",
    "allow-set-close-to-tray",
    "allow-send-to-background"
  ]
}
