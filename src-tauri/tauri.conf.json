{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tarpaulin",
  "version": "0.2.1",
  "identifier": "dev.tarpaulin.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tarpaulin",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false,
        "backgroundColor": "#0f1117",
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Copyright © 2026 Ethan Wright. GPL-3.0; see NOTICE.md for the name and icon.",
    "license": "GPL-3.0-only",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "category": "Education",
    "shortDescription": "A calmer dashboard for Canvas LMS"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFREUxNTM1NDg0RTQwRTAKUldUZ1FFNUlOUlhlcm1YT3ZicXRvWENBbEF5L01sRnl4emRPMjFSVHhqcnQyNEhBTFVxZ1ZZaEQK",
      "endpoints": [
        "https://github.com/dusty369289/tarpaulin/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
